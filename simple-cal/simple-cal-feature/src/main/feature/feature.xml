<features xmlns="http://karaf.apache.org/xmlns/features/v1.6.0"
    name="simple-cal">

    <repository>
        mvn:org.apache.cxf.karaf/apache-cxf/3.5.5/xml/features
    </repository>
    <repository>
        mvn:org.apache.karaf.features/standard/4.4.9/xml/features
    </repository>

    <feature name="simple-cal-api" version="0.0.1-SNAPSHOT">
        <bundle>mvn:demo/simple-cal-api/0.0.1-SNAPSHOT</bundle>
    </feature>

    <feature name="simple-cal-app" version="0.0.1-SNAPSHOT">
        <feature>simple-cal-api</feature>
        <bundle>mvn:demo/simple-cal-app/0.0.1-SNAPSHOT</bundle>
    </feature>

    <feature name="simple-cal-rest" version="0.0.1-SNAPSHOT">
        <feature>simple-cal-api</feature>
        <feature>simple-cal-app</feature>

        <feature>pax-web-http</feature>
        <feature>scr</feature>
        <feature>blueprint-web</feature>
        <feature>cxf-jaxrs</feature>
        <feature>cxf-jackson</feature>

        <bundle>mvn:demo/simple-cal-rest/0.0.1-SNAPSHOT</bundle>
    </feature>

    <feature name="simple-cal" version="0.0.1-SNAPSHOT">
        <feature>simple-cal-rest</feature>
    </feature>

</features>